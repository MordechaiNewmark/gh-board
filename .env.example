# --- Claude auth ---
# Easiest: leave all of this blank and choose the method in the app (gear icon > Settings > Claude).
# A choice saved there (in .claude-auth.json) overrides this file; this file is the fallback.
#
# Subscription billing: run `claude setup-token` once and paste the result here.
# (If you leave this out, the SDK falls back to your `claude login` session on this machine.)
CLAUDE_CODE_OAUTH_TOKEN=
# API billing: an Anthropic API key. Chat and repo analysis are then charged per token to that API account,
# not to a Claude subscription. Used only when CLAUDE_CODE_OAUTH_TOKEN is blank, and only when written in this
# file or saved in Settings: a key that is merely exported in your shell is ignored.
ANTHROPIC_API_KEY=

# --- GitHub auth ---
# Easiest: connect accounts in the app (account button in the header). You can connect several at once;
# they are stored in .gh-accounts.json next to the server.
# A token here is one extra account ("GITHUB_TOKEN in .env"). Classic PAT with `repo` scope (+ `read:org`)
# sees repos you were invited to. Orgs with SSO: click "Configure SSO -> Authorize" on the token.
# A `gh auth login` session from the GitHub CLI is picked up as an account too.
GITHUB_TOKEN=

# --- Optional ---
PORT=3000
# Board columns are driven by labels named "<prefix><Column>", e.g. "status:In progress".
STATUS_PREFIX=status:
COLUMNS=Backlog,Todo,In progress,Review,Done
# Last column closes the issue; moving out of it reopens it.
# Model for the chat. Blank = your account's default. Settings > Claude > Model overrides this.
CLAUDE_MODEL=

# Optional: "Sign in with GitHub" button (device flow) in the UI. Each sign-in adds an account.
# Create an OAuth app at github.com/settings/developers, tick "Enable Device Flow",
# and paste its Client ID here. Without it, the UI offers paste-a-token only.
GITHUB_CLIENT_ID=

# Optional: open the board from your phone (same Wi-Fi, or Tailscale).
# HOST=0.0.0.0 requires ACCESS_KEY. List every address you will type, with the port.
# First visit on the phone: http://<address>:3000/?key=<ACCESS_KEY>
HOST=
ACCESS_KEY=
ALLOWED_HOSTS=

# Optional: repo analysis (the chat clones the selected repo into .repo-cache/ and reads it locally).
# Largest repo to clone, in MB as reported by GitHub. Default 300.
ANALYSIS_MAX_MB=
# Kill a clone/fetch after this many seconds. Default 180.
ANALYSIS_SYNC_TIMEOUT_S=
# Largest single file the agent may open, in MB. Default 5.
ANALYSIS_MAX_FILE_MB=
# READ_ONLY=1 blocks every write to GitHub (board and chat). The agent can still analyze and propose.
READ_ONLY=

# Optional: other LLM providers for the chat (Claude stays the default). Keys can also be saved in the UI
# (Settings > Providers), which takes priority. Keys never reach the browser or any child process.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Custom OpenAI-compatible providers can read any variable ending in _API_KEY, e.g. GROQ_API_KEY=
# Limits for non-Claude providers: model turns per message (60), seconds per message (1200),
# characters per tool result (30000), characters of tool output kept per conversation (300000).
PROVIDER_MAX_STEPS=
PROVIDER_TIMEOUT_S=
PROVIDER_TOOL_OUTPUT_CHARS=
PROVIDER_HISTORY_CHARS=
